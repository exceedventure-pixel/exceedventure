# ─── Server ───────────────────────────────────────────────────────────────────
# Public URL of your deployed site — no trailing slash
NEXT_PUBLIC_SERVER_URL=https://yourdomain.com

# Strong random string used to sign Payload JWTs and encrypt tokens
# Generate one with: openssl rand -base64 32
PAYLOAD_SECRET=change-me-to-a-strong-random-secret

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# In Dokploy, create a PostgreSQL service and use its internal connection string.
# e.g. postgresql://payload:password@postgres:5432/payload
DATABASE_URL=postgresql://payload:payload@localhost:5432/payload

# ─── Primary admin ────────────────────────────────────────────────────────────
# On every boot this account is created if missing, and its password is reset to
# ADMIN_PASSWORD if it already exists. That makes the environment the source of
# truth and gives you a guaranteed way back in if credentials are ever lost.
#
# Two consequences worth knowing:
#   - Changing THIS account's password in the admin UI is undone on the next
#     restart. Create a second account for daily use if that matters.
#   - Leave both unset (as here) and nothing happens — local dev is untouched.
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD=set-a-strong-password
# ADMIN_NAME=Administrator

# ─── Primary CRM login (/crm) ─────────────────────────────────────────────────
# REQUIRED ON A NEW DEPLOYMENT. The CRM lives in its own account collection, and
# only an existing staff admin can create a team login — so without this there
# is no way to make the first one and /crm is unreachable.
#
# Separate from ADMIN_* above because these are two different products with two
# different login pages: /admin is the CMS, /crm is the team CRM. One person can
# hold both, but they are two accounts and two passwords.
#
# Same rules as the CMS admin: created if missing, password reset to this value
# on every restart, and the role is forced back to admin so a demotion or a
# pause cannot lock you out.
# CRM_ADMIN_EMAIL=you@yourdomain.com
# CRM_ADMIN_PASSWORD=set-a-different-strong-password
# CRM_ADMIN_NAME=Administrator

# ─── Who can do what ──────────────────────────────────────────────────────────
# Both admin areas are INVITE ONLY. There is no public signup for /admin or
# /crm — the accounts above are created at boot, and everyone else is added from
# inside by someone who already has access.
#
#   /admin (CMS)   superAdmin  everything, including other admins. This is the
#                              ADMIN_EMAIL account. Cannot be demoted, paused or
#                              deleted by an admin, so you always have a way in.
#                  admin       content, media, site settings, inviting editors.
#                  editor      content only. No user management, no settings.
#
#   /crm           admin       everything, including team accounts and billing.
#                              CRM_ADMIN_EMAIL is provisioned here and is
#                              likewise protected from demotion or removal.
#                  manager     every client, project and invoice; no team admin.
#                  member      only the clients and projects assigned to them.
#
#   /portal        Clients self-register and land as `pending`. They see a
#                  waiting screen and read nothing until your team approves
#                  them in /crm → Requests.
#
# Nobody can grant a rank they do not hold — an admin cannot make themselves a
# superAdmin, and the attempt is ignored rather than partially applied.

# ─── Google sign-in (optional) ────────────────────────────────────────────────
# Leave unset and the "Continue with Google" button is hidden entirely, on both
# /portal and /crm — email and password keep working. Set both to switch it on.
# Authorised redirect URIs in the Google console must be:
#   https://yourdomain.com/portal/api/auth/google/callback
#   https://yourdomain.com/crm/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ─── Cloudflare R2 Storage ────────────────────────────────────────────────────
# Create an R2 bucket in Cloudflare, then generate an API token with
# Object Read & Write permissions.
S3_BUCKET=your-r2-bucket-name
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-r2-access-key-id
S3_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Public URL used to serve uploaded media files.
# Enable "Public Access" in the Cloudflare dashboard to get this URL.
S3_PUBLIC_URL=https://pub-<hash>.r2.dev

# If you use a custom domain instead of *.r2.dev, set the hostname here so
# Next.js Image Optimisation can fetch it:
# S3_CDN_HOSTNAME=media.yourdomain.com

# ─── Transactional email (CRM + client dashboard) ─────────────────────────────
# Powers welcome mail, approvals, project and invoice updates, team invites and
# replies from the shared mailbox.
#
# Leave RESEND_API_KEY unset and email is simply disabled — every send becomes a
# no-op and logs once. Nothing in the CRM fails without it, but a teammate you
# invite will not receive their password, and clients will not be told when
# their account is approved.
#
# The sending domain must be verified in Resend first.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=Exceed Venture <noreply@exceedventure.com>
# Domain used to build support@ / sales@ / billing@ sender addresses in the
# mailbox. Defaults to exceedventure.com.
# RESEND_DOMAIN=exceedventure.com

# Inbound mail. Point your provider's inbound webhook at
#   POST /crm/api/inbound-email
# passing this secret as ?token=… or an X-Webhook-Secret header. Replies to
# support@ then appear in the CRM mailbox instead of a real inbox somewhere.
#
# Leave it unset and the route refuses every request — it fails closed, because
# an open version would let anyone post a message as any client.
# INBOUND_EMAIL_SECRET=generate-a-long-random-string

# ─── Optional SEO ─────────────────────────────────────────────────────────────
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
